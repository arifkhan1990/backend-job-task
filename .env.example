NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/notes_api
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
JWT_EXPIRES_IN=1h
JWT_ISSUER=notes-api
JWT_AUDIENCE=notes-client
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12

# Used only by `npm run seed:admin`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-local-env
